# ==========================================
# 1. Base de Dados (Datasets de Áudio)
# ==========================================
# Ignora toda a pasta de áudios/datasets e subpastas
data/*
*.flac
*.wav
*.mp3
*.aac
*.zip
*.tar.gz

# ==========================================
# 2. Python e Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 3. Ambientes Virtuais (.venv / env)
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# 4. Variáveis de Ambiente e Segredos
# ==========================================
.env
.env.local

# ==========================================
# 5. IDEs e Editores (VSCode, PyCharm, Cursor)
# ==========================================
.vscode/
.idea/
.cursor/
.cursorignore
.cursorindexingignore
*.swp

# ==========================================
# 6. Checkpoints de Treino e Modelos Salvos
# ==========================================
# Evita subir modelos treinados pesados (.pkl, .pt, .h5, etc.)
*.pkl
*.joblib
*.pt
*.pth
*.h5
checkpoints/
logs/